# ─── BD Signal — Environment Configuration ──────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Server ───────────────────────────────────────────────────
PORT=3000

# ── Authentication (see src/auth.js for details) ─────────────
# These are STUBS — fill in when you receive official credentials
# from the BD Number Lookup API owner (https://t.me/Gajarbotol).

# Official API key (when issued)
# BD_API_KEY=

# HMAC signing secret (if required)
# BD_API_SECRET=

# Referer header (optional override — defaults to upstream site)
# BD_API_REFERER=https://bd-num-lookup.vercel.app

# ── Rate Limiting ─────────────────────────────────────────────
# Requests per window per IP (default: 60 per 15 minutes)
# RATE_LIMIT_MAX=60
# RATE_LIMIT_WINDOW_MS=900000
